# ============================================================
# RAPIDE — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# ── Database (Supabase) ─────────────────────────────────────
# Use pgbouncer=true for connection pooling in production
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?pgbouncer=true&connection_limit=1"
# Direct URL bypasses pgBouncer — required for Prisma migrations
DIRECT_DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# ── Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[ANON_KEY]"
SUPABASE_SERVICE_ROLE_KEY="[SERVICE_ROLE_KEY]"
SUPABASE_JWT_SECRET="[JWT_SECRET_FROM_SUPABASE_DASHBOARD]"

# ── API Server ──────────────────────────────────────────────
API_PORT=3001
API_URL="http://localhost:3001"
NEXT_PUBLIC_API_URL="http://localhost:3001"
JWT_SECRET="[generate: openssl rand -base64 64]"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="30d"
API_CORS_ORIGINS="http://localhost:3000,http://localhost:3002,http://localhost:3003"

# ── Redis ───────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""

# ── Mapbox ──────────────────────────────────────────────────
# Public token (safe to expose in browser)
NEXT_PUBLIC_MAPBOX_TOKEN="pk.[YOUR_MAPBOX_PUBLIC_TOKEN]"
# Secret token (server-side only)
MAPBOX_SECRET_TOKEN="sk.[YOUR_MAPBOX_SECRET_TOKEN]"

# ── Payments: Flutterwave ───────────────────────────────────
FLUTTERWAVE_PUBLIC_KEY="FLWPUBK_TEST-[KEY]"
FLUTTERWAVE_SECRET_KEY="FLWSECK_TEST-[KEY]"
FLUTTERWAVE_ENCRYPTION_KEY="[ENCRYPTION_KEY]"
FLUTTERWAVE_WEBHOOK_SECRET="[WEBHOOK_HASH_SECRET]"

# ── Payments: Stripe ────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_[KEY]"
STRIPE_PUBLISHABLE_KEY="pk_test_[KEY]"
STRIPE_WEBHOOK_SECRET="whsec_[KEY]"

# ── Push Notifications (Firebase) ───────────────────────────
FCM_PROJECT_ID="[FIREBASE_PROJECT_ID]"
FCM_CLIENT_EMAIL="[FIREBASE_CLIENT_EMAIL]"
FCM_PRIVATE_KEY="[FIREBASE_PRIVATE_KEY]"

# ── Storage (Supabase Storage) ──────────────────────────────
SUPABASE_STORAGE_BUCKET_PROOFS="delivery-proofs"
SUPABASE_STORAGE_BUCKET_DOCUMENTS="rider-documents"
SUPABASE_STORAGE_BUCKET_AVATARS="avatars"

# ── Monitoring: Sentry ──────────────────────────────────────
SENTRY_DSN_WEB="https://[KEY]@o[ID].ingest.sentry.io/[PROJECT]"
SENTRY_DSN_ADMIN="https://[KEY]@o[ID].ingest.sentry.io/[PROJECT]"
SENTRY_DSN_MERCHANT="https://[KEY]@o[ID].ingest.sentry.io/[PROJECT]"
SENTRY_DSN_API="https://[KEY]@o[ID].ingest.sentry.io/[PROJECT]"
SENTRY_ORG="rapide"
SENTRY_PROJECT="rapide-api"
SENTRY_AUTH_TOKEN="[SENTRY_AUTH_TOKEN]"

# ── Monitoring: Axiom ───────────────────────────────────────
AXIOM_TOKEN="[AXIOM_API_TOKEN]"
AXIOM_DATASET="rapide-api-logs"

# ── App URLs (set in each environment) ─────────────────────
NEXT_PUBLIC_WEB_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3002"
NEXT_PUBLIC_MERCHANT_URL="http://localhost:3003"

# ── App Config ──────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Rapide"
NEXT_PUBLIC_DEFAULT_LOCALE="fr"
NEXT_PUBLIC_SUPPORT_EMAIL="support@rapide.bj"
NEXT_PUBLIC_SUPPORT_PHONE="+22961000000"

# ── Rate Limiting ───────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100
